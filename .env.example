# Public Live Radio Audio Stream URL for Khulumani FM 95.0
NEXT_PUBLIC_STREAM_URL=https://khulumanistream.zbc.co.zw:8000/radio.mp3

# Studio Admin login email for the Khulumani FM Content CRM (/crm)
CRM_ADMIN_EMAIL=admin@example.com

# Bcrypt hash of the Studio Admin password (verified server-side only via bcryptjs)
CRM_ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash_from_cli

# Server-side HMAC secret (min 32 chars) used to sign HttpOnly CRM session cookies
CRM_SESSION_SECRET=replace_with_32_byte_random_hex_session_secret

# Comma-separated explicit CORS origin allowlist for state-changing API routes
ALLOWED_ORIGINS=https://khulumani.hakili.online,http://localhost:3000
